# ============================================================
# TransitIQ Backend – Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# MySQL Database (via Prisma)
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/transitiq_db"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082,exp://localhost:8081
